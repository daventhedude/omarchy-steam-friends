missing_jq_snapshot() {
  printf '%s\n' '{"ok":false,"configured":false,"stale":false,"error":"Steam Friends requires jq, but it is not installed.","warning":"","generatedAt":0,"self":null,"friends":[],"counts":{"total":0,"online":0,"inGame":0}}'
}

case "${1:-snapshot}" in
  snapshot)
    if command -v jq >/dev/null 2>&1; then snapshot; else missing_jq_snapshot; fi
    ;;
  setup)
    if command -v jq >/dev/null 2>&1; then
      setup_account
    else
      printf '%s\n' 'Steam Friends requires jq, but it is not installed.' >&2
      exit 69
    fi
    ;;
  demo) demo_snapshot ;;
  steam-action)
    shift
    steam_action "$@"
    ;;
  *)
    printf 'Usage: %s [snapshot|setup|demo|steam-action]\n' "${0##*/}" >&2
    exit 64
    ;;
esac

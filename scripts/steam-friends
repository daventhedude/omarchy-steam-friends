#!/usr/bin/env bash
set -uo pipefail

PLUGIN_NAME="Steam Friends"
CONFIG_ROOT="${XDG_CONFIG_HOME:-${HOME}/.config}"
CACHE_ROOT="${XDG_CACHE_HOME:-${HOME}/.cache}"
CONFIG_DIR="${CONFIG_ROOT}/omarchy"
CONFIG_FILE="${CONFIG_DIR}/steam-friends.json"
CACHE_DIR="${CACHE_ROOT}/omarchy-steam-friends"
CACHE_FILE="${CACHE_DIR}/snapshot.json"
ACTION_LOCK_FILE="${CACHE_DIR}/steam-action.lock"
ACTION_GUARD_FILE="${CACHE_DIR}/steam-action.guard"
API_ROOT="https://api.steampowered.com/ISteamUser"
MAX_RESPONSE_BYTES=2097152
MAX_CACHE_BYTES=8388608
MAX_CONFIG_BYTES=4096
MAX_CACHE_AGE_SECONDS=86400
MIN_NETWORK_INTERVAL_SECONDS=60
ACTIVE_TMP=""
CURRENT_STEAM_ID=""

umask 077
if ! ulimit -c 0 2>/dev/null; then
  printf '%s\n' 'Steam Friends could not disable core dumps safely.' >&2
  exit 70
fi

cleanup_active_tmp() {
  if [[ -n "$ACTIVE_TMP" && -e "$ACTIVE_TMP" ]]; then
    rm -f -- "$ACTIVE_TMP"
  fi
}

trap cleanup_active_tmp EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

owned_directory() {
  local path="$1"
  local owner

  [[ -d "$path" && ! -L "$path" ]] || return 1
  owner="$(stat -c '%u' -- "$path" 2>/dev/null)" || return 1
  [[ "$owner" == "$EUID" ]]
}

private_directory() {
  local path="$1"
  local mode mode_value

  owned_directory "$path" || return 1
  mode="$(stat -c '%a' -- "$path" 2>/dev/null)" || return 1
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  mode_value=$((8#$mode))
  (( (mode_value & 077) == 0 ))
}

private_regular_file() {
  local path="$1"
  local owner mode mode_value links

  [[ -f "$path" && ! -L "$path" && -r "$path" ]] || return 1
  owner="$(stat -c '%u' -- "$path" 2>/dev/null)" || return 1
  mode="$(stat -c '%a' -- "$path" 2>/dev/null)" || return 1
  links="$(stat -c '%h' -- "$path" 2>/dev/null)" || return 1
  [[ "$owner" == "$EUID" && "$links" == "1" && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  mode_value=$((8#$mode))
  (( (mode_value & 077) == 0 ))
}

cache_snapshot() {
  local expected_id="$1"
  local max_age="${2:-$MAX_CACHE_AGE_SECONDS}"
  local stale="${3:-true}"
  local size

  [[ "$expected_id" =~ ^[0-9]{17}$ ]] || return 1
  [[ "$max_age" =~ ^[0-9]+$ ]] || return 1
  [[ "$stale" == "true" || "$stale" == "false" ]] || return 1
  private_directory "$CACHE_DIR" || return 1
  private_regular_file "$CACHE_FILE" || return 1
  size="$(stat -c '%s' -- "$CACHE_FILE" 2>/dev/null)" || return 1
  [[ "$size" =~ ^[0-9]+$ ]] || return 1
  (( size > 0 && size <= MAX_CACHE_BYTES )) || return 1

  jq -ce \
    --arg expectedId "$expected_id" \
    --argjson maxAge "$max_age" \
    --argjson stale "$stale" '
    def steam_id:
      type == "string" and test("^[0-9]{17}$");
    def safe_text($max):
      type == "string" and length <= $max
      and (test("[[:cntrl:]]") | not)
      and (test("[\u202a-\u202e\u2066-\u2069]") | not);
    def safe_avatar:
      . == ""
      or (type == "string" and length <= 1024 and (
        test("^https://([A-Za-z0-9-]+\\.)*steamstatic\\.com/[A-Za-z0-9_./%?=&+-]+$")
        or test("^https://steamcdn-a\\.akamaihd\\.net/steamcommunity/public/images/avatars/[A-Za-z0-9_./%?=&+-]+$")
      ));
    def player:
      type == "object"
      and (.steamId | steam_id)
      and (.name | safe_text(128))
      and (.realName | safe_text(128))
      and (.profileUrl == ("https://steamcommunity.com/profiles/" + .steamId + "/"))
      and (.avatar | safe_avatar)
      and (.state | type == "number" and . >= 0 and . <= 6)
      and (.stateFlags | type == "number" and . >= 0 and . <= 2147483647)
      and (.gameName | safe_text(256))
      and (.gameId | type == "string" and (. == "" or test("^[0-9]{1,12}$")))
      and (.lastLogoff | type == "number" and . >= 0 and . <= 4102444800)
      and (.friendSince | type == "number" and . >= 0 and . <= 4102444800)
      and (.country | type == "string" and (. == "" or test("^[A-Z]{2}$")))
      and (.isSelf | type == "boolean");

    select(
      type == "object"
      and .ok == true
      and .configured == true
      and .accountId == $expectedId
      and (.stale | type == "boolean")
      and (.generatedAt | type == "number" and . >= 0 and . <= 4102444800)
      and (.generatedAt >= (now - $maxAge) and .generatedAt <= (now + 300))
      and (.self == null or (.self | player and .isSelf == true))
      and (.friends | type == "array" and length <= 5000)
      and all(.friends[]; player and (.isSelf | not))
      and (([.friends[].steamId] | length) == ([.friends[].steamId] | unique | length))
      and (.self == null or (
        .self.steamId == .accountId
        and
        .self.steamId as $selfId
        | ([.friends[].steamId] | index($selfId)) == null
      ))
    )
    | .friends as $friends
    | {
        ok: true,
        configured: true,
        accountId: .accountId,
        stale: $stale,
        error: "",
        warning: "",
        generatedAt: .generatedAt,
        self: .self,
        friends: $friends,
        counts: {
          total: ($friends | length),
          online: ($friends | map(select(.state > 0)) | length),
          inGame: ($friends | map(select(.gameName != "")) | length)
        }
      }
  ' "$CACHE_FILE"
}

write_private_file() {
  local directory="$1"
  local destination="$2"
  local prefix="$3"
  local content="$4"

  [[ ! -L "$directory" ]] || return 1
  mkdir -p -- "$directory" || return 1
  owned_directory "$directory" || return 1
  ACTIVE_TMP="$(mktemp "${directory}/${prefix}.XXXXXX")" || return 1
  printf '%s\n' "$content" >"$ACTIVE_TMP" || return 1
  chmod 600 -- "$ACTIVE_TMP" || return 1
  mv -fT -- "$ACTIVE_TMP" "$destination" || return 1
  ACTIVE_TMP=""
  private_regular_file "$destination"
}

prepare_cache_dir() {
  [[ ! -L "$CACHE_DIR" ]] || return 1
  mkdir -p -- "$CACHE_DIR" || return 1
  owned_directory "$CACHE_DIR" || return 1
  chmod 700 -- "$CACHE_DIR" || return 1
  private_directory "$CACHE_DIR"
}

steam_process_running() {
  command -v pgrep >/dev/null 2>&1 || return 1
  pgrep -u "$EUID" -x steam >/dev/null 2>&1
}

steam_pipe_ready() {
  local pipe
  local -a candidates=(
    "${HOME}/.steam/steam.pipe"
    "${HOME}/.local/share/Steam/config/steam.pipe"
    "${HOME}/.var/app/com.valvesoftware.Steam/.steam/steam.pipe"
  )

  steam_process_running || return 1

  for pipe in "${candidates[@]}"; do
    [[ -p "$pipe" ]] && return 0
  done
  return 1
}

read_action_guard() {
  local guard size

  if [[ ! -e "$ACTION_GUARD_FILE" ]]; then
    printf '%s\n' 0
    return
  fi

  private_regular_file "$ACTION_GUARD_FILE" || return 1
  size="$(stat -c '%s' -- "$ACTION_GUARD_FILE" 2>/dev/null)" || return 1
  [[ "$size" =~ ^[0-9]+$ ]] || return 1
  (( size > 0 && size <= 32 )) || return 1
  IFS= read -r guard <"$ACTION_GUARD_FILE" || return 1
  [[ "$guard" =~ ^[0-9]{1,12}$ ]] || return 1
  printf '%s\n' "$guard"
}

write_action_guard() {
  local not_before="$1"

  [[ "$not_before" =~ ^[0-9]{1,12}$ ]] || return 1
  write_private_file \
    "$CACHE_DIR" "$ACTION_GUARD_FILE" ".steam-action-guard" "$not_before"
}

acquire_action_lock() {
  local -n output_fd="$1"

  command -v flock >/dev/null 2>&1 || return 69
  prepare_cache_dir || return 70

  if [[ ! -e "$ACTION_LOCK_FILE" ]]; then
    (umask 077; : >"$ACTION_LOCK_FILE") || return 70
    chmod 600 -- "$ACTION_LOCK_FILE" || return 70
  fi
  private_regular_file "$ACTION_LOCK_FILE" || return 70

  exec {output_fd}<>"$ACTION_LOCK_FILE" || return 70
  private_regular_file "$ACTION_LOCK_FILE" || return 70
  flock -n "$output_fd" || return 75
}

steam_action() {
  local kind="${1:-}"
  local steam_id="${2:-}"
  local uri now not_before lock_fd ready_before=false attempt

  case "$kind" in
    chat)
      (( $# == 2 )) || return 64
      [[ "$steam_id" =~ ^[0-9]{17}$ ]] || return 64
      uri="steam://friends/message/${steam_id}"
      ;;
    friends)
      (( $# == 1 )) || return 64
      uri='steam://open/friends'
      ;;
    *) return 64 ;;
  esac

  command -v xdg-open >/dev/null 2>&1 || return 69
  command -v pgrep >/dev/null 2>&1 || return 69
  acquire_action_lock lock_fd || return $?

  now="$(date +%s)" || return 70
  [[ "$now" =~ ^[0-9]{1,12}$ ]] || return 70
  not_before="$(read_action_guard)" || return 70
  if (( not_before > now + 90 )); then
    # Recover safely from a large backwards wall-clock jump or corrupted local
    # timestamp without ever turning that anomaly into an immediate relaunch.
    write_action_guard "$((now + 45))" || return 70
    return 75
  fi
  (( now >= not_before )) || return 75

  if steam_pipe_ready; then
    ready_before=true
    write_action_guard "$((now + 2))" || return 70
  elif steam_process_running; then
    # A client that exists but has not created its command pipe is still in a
    # cold start. Never compete with it, even on a machine that needs longer
    # than the normal guard window to initialize.
    write_action_guard "$((now + 15))" || return 70
    return 75
  else
    # A cold Steam start took about 20 seconds in real-world validation. Keep
    # the guard beyond that window so impatient repeat input cannot launch
    # competing clients before Steam's command pipe is available.
    write_action_guard "$((now + 45))" || return 70
  fi

  if ! xdg-open "$uri" >/dev/null 2>&1; then
    write_action_guard "$now" >/dev/null 2>&1 || true
    return 70
  fi

  [[ "$ready_before" == true ]] && return 0

  for ((attempt = 0; attempt < 90; attempt++)); do
    if steam_pipe_ready; then
      now="$(date +%s)" || return 70
      write_action_guard "$((now + 2))" || return 70
      return 0
    fi
    sleep 0.5
  done

  return 75
}

json_error() {
  local message="$1"
  local configured="${2:-true}"
  local cached=""

  if [[ "$configured" == "true" ]] \
    && cached="$(cache_snapshot "$CURRENT_STEAM_ID" "$MAX_CACHE_AGE_SECONDS" true 2>/dev/null)"; then
    jq -c --arg warning "$message" \
      '. + {ok: true, configured: true, stale: true, warning: $warning}' \
      <<<"$cached"
    return
  fi

  jq -cn \
    --argjson configured "$configured" \
    --arg message "$message" \
    '{
      ok: false,
      configured: $configured,
      stale: false,
      error: $message,
      warning: "",
      generatedAt: 0,
      self: null,
      friends: [],
      counts: {total: 0, online: 0, inGame: 0}
    }'
}

detect_steam_id() {
  local candidate=""
  local login_file=""
  local -a candidates=(
    "${HOME}/.local/share/Steam/config/loginusers.vdf"
    "${HOME}/.steam/steam/config/loginusers.vdf"
    "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/config/loginusers.vdf"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -r "$candidate" ]]; then
      login_file="$candidate"
      break
    fi
  done

  [[ -n "$login_file" ]] || return 1

  awk '
    match($0, /"([0-9]{17})"/, id) {
      if (first == "") first = id[1]
      current = id[1]
      next
    }
    current != "" && /"MostRecent"[[:space:]]+"1"/ { print current; found = 1; exit }
    END { if (!found && first != "") print first }
  ' "$login_file" | head -n 1
}

read_config() {
  local size

  owned_directory "$CONFIG_DIR" || return 1
  private_regular_file "$CONFIG_FILE" || return 1
  size="$(stat -c '%s' -- "$CONFIG_FILE" 2>/dev/null)" || return 1
  [[ "$size" =~ ^[0-9]+$ ]] || return 1
  (( size > 0 && size <= MAX_CONFIG_BYTES )) || return 1
  jq -e '
    type == "object" and
    (.apiKey | type == "string" and test("^[A-Fa-f0-9]{32}$")) and
    (.steamId | type == "string" and test("^[0-9]{17}$")) and
    (keys | sort == ["apiKey", "steamId"])
  ' "$CONFIG_FILE" >/dev/null 2>&1
}

api_get() {
  local endpoint="$1"
  local api_key="$2"
  shift 2

  case "$endpoint" in
    "${API_ROOT}/GetFriendList/v1/")
      (( $# == 2 )) || return 64
      [[ "$1" =~ ^steamid=[0-9]{17}$ && "$2" == "relationship=friend" ]] || return 64
      ;;
    "${API_ROOT}/GetPlayerSummaries/v2/")
      (( $# == 1 )) || return 64
      [[ "$1" =~ ^steamids=[0-9]{17}(,[0-9]{17}){0,99}$ ]] || return 64
      ;;
    *) return 64 ;;
  esac
  [[ "$api_key" =~ ^[A-Fa-f0-9]{32}$ ]] || return 64

  {
    printf '%s\n' \
      'get' \
      'silent' \
      'show-error' \
      'fail-with-body' \
      'connect-timeout = 4' \
      'max-time = 12' \
      'retry = 1' \
      'retry-delay = 1' \
      'header = "Accept: application/json"'
    printf 'url = "%s"\n' "$endpoint"
    printf 'header = "x-webapi-key: %s"\n' "$api_key"
    for parameter in "$@"; do
      printf 'data-urlencode = "%s"\n' "$parameter"
    done
  } | curl --disable \
    --proto '=https' \
    --tlsv1.2 \
    --max-filesize "$MAX_RESPONSE_BYTES" \
    --config -
}

normalize_player() {
  jq -c '
    def text($max):
      if type == "string"
      then gsub("[[:cntrl:]]"; " ")
        | gsub("[\u202a-\u202e\u2066-\u2069]"; "")
        | .[0:$max]
      else ""
      end;
    def integer($min; $max):
      (tonumber? // $min) | floor | if . < $min then $min elif . > $max then $max else . end;
    def steam_id:
      type == "string" and test("^[0-9]{17}$");
    def avatar:
      (. // "" | text(1024)) as $url
      | if (
          $url | test("^https://([A-Za-z0-9-]+\\.)*steamstatic\\.com/[A-Za-z0-9_./%?=&+-]+$")
          or test("^https://steamcdn-a\\.akamaihd\\.net/steamcommunity/public/images/avatars/[A-Za-z0-9_./%?=&+-]+$")
        ) then $url else "" end;
    def player($friendMap; $selfId):
      . as $p
      | ($friendMap[$p.steamid] // {}) as $friend
      | {
          steamId: $p.steamid,
          name: (($p.personaname // "Unknown") | text(128) | if . == "" then "Unknown" else . end),
          realName: (($p.realname // "") | text(128)),
          profileUrl: ("https://steamcommunity.com/profiles/" + $p.steamid + "/"),
          avatar: (($p.avatarfull // $p.avatarmedium // $p.avatar // "") | avatar),
          state: (($p.personastate // 0) | integer(0; 6)),
          stateFlags: (($p.personastateflags // 0) | integer(0; 2147483647)),
          gameName: (($p.gameextrainfo // "") | text(256)),
          gameId: (($p.gameid // "") | tostring | if test("^[0-9]{1,12}$") then . else "" end),
          lastLogoff: (($p.lastlogoff // 0) | integer(0; 4102444800)),
          friendSince: (($friend.friend_since // 0) | integer(0; 4102444800)),
          country: (($p.loccountrycode // "") | text(2) | ascii_upcase | if test("^[A-Z]{2}$") then . else "" end),
          isSelf: ($p.steamid == $selfId)
        };

    . as $input
    | ($input.friends.friends // []
      | map({key: .steamid, value: .})
      | from_entries) as $friendMap
    | ($input.players
      | map(select(
          (.steamid | steam_id)
          and (.steamid == $input.selfId or $friendMap[.steamid] != null)
        ))
      | map(player($friendMap; $input.selfId))
      | unique_by(.steamId)) as $players
    | ($players | map(select(.isSelf)) | first // null) as $self
    | ($players
      | map(select(.isSelf | not))
      | sort_by(
          (if .gameName != "" then 0 elif .state > 0 then 1 else 2 end),
          (.name | ascii_downcase)
        )) as $friends
    | {
        ok: true,
        configured: true,
        accountId: $input.selfId,
        stale: false,
        error: "",
        warning: "",
        generatedAt: (now | floor),
        self: $self,
        friends: $friends,
        counts: {
          total: ($friends | length),
          online: ($friends | map(select(.state > 0)) | length),
          inGame: ($friends | map(select(.gameName != "")) | length)
        }
      }
  '
}

snapshot() {
  if ! read_config; then
    jq -cn '{
      ok: false,
      configured: false,
      stale: false,
      error: "",
      warning: "",
      generatedAt: 0,
      self: null,
      friends: [],
      counts: {total: 0, online: 0, inGame: 0}
    }'
    return
  fi

  local api_key steam_id recent_snapshot friends_json summaries_json response ids_csv next_players
  local -a friend_ids all_ids batch
  api_key="$(jq -r '.apiKey' "$CONFIG_FILE")"
  steam_id="$(jq -r '.steamId' "$CONFIG_FILE")"
  CURRENT_STEAM_ID="$steam_id"

  if recent_snapshot="$(cache_snapshot \
    "$steam_id" "$MIN_NETWORK_INTERVAL_SECONDS" false 2>/dev/null)"; then
    printf '%s\n' "$recent_snapshot"
    return
  fi

  if ! command -v curl >/dev/null 2>&1; then
    json_error "Steam Friends requires curl, but it is not installed."
    return
  fi

  if ! friends_json="$(api_get \
    "${API_ROOT}/GetFriendList/v1/" \
    "$api_key" \
    "steamid=${steam_id}" \
    'relationship=friend' 2>/dev/null)"; then
    json_error "Steam rejected the friends request. Check the API key and make sure your friends list is public."
    return
  fi

  if ! jq -e '
    .friendslist.friends | type == "array"
    and length <= 5000
    and all(.[]; (
      type == "object"
      and (.steamid | type == "string" and test("^[0-9]{17}$"))
      and (.friend_since | type == "number" and . >= 0 and . <= 4102444800)
    ))
  ' <<<"$friends_json" >/dev/null 2>&1; then
    json_error "Steam returned an unexpected friends response."
    return
  fi

  mapfile -t friend_ids < <(jq -r '.friendslist.friends | map(.steamid) | unique[]' <<<"$friends_json")
  all_ids=("$steam_id" "${friend_ids[@]}")
  summaries_json='[]'

  local start
  for ((start = 0; start < ${#all_ids[@]}; start += 100)); do
    batch=("${all_ids[@]:start:100}")
    ids_csv="$(IFS=,; printf '%s' "${batch[*]}")"

    if ! response="$(api_get \
      "${API_ROOT}/GetPlayerSummaries/v2/" \
      "$api_key" \
      "steamids=${ids_csv}" 2>/dev/null)"; then
      json_error "Steam presence is temporarily unavailable."
      return
    fi

    if ! jq -e '
      .response.players | type == "array"
      and length <= 100
      and all(.[]; type == "object" and (.steamid | type == "string" and test("^[0-9]{17}$")))
    ' <<<"$response" >/dev/null 2>&1; then
      json_error "Steam returned an unexpected presence response."
      return
    fi

    next_players="$(jq -c '
      def text($max):
        if type == "string"
        then gsub("[[:cntrl:]]"; " ")
          | gsub("[\u202a-\u202e\u2066-\u2069]"; "")
          | .[0:$max]
        else ""
        end;
      def integer($min; $max):
        (tonumber? // $min) | floor
        | if . < $min then $min elif . > $max then $max else . end;

      [.response.players[] | {
        steamid,
        personaname: ((.personaname // "") | text(128)),
        realname: ((.realname // "") | text(128)),
        avatarfull: ((.avatarfull // .avatarmedium // .avatar // "") | text(512)),
        personastate: ((.personastate // 0) | integer(0; 6)),
        personastateflags: ((.personastateflags // 0) | integer(0; 2147483647)),
        gameextrainfo: ((.gameextrainfo // "") | text(256)),
        gameid: ((.gameid // "") | tostring | if test("^[0-9]{1,12}$") then . else "" end),
        lastlogoff: ((.lastlogoff // 0) | integer(0; 4102444800)),
        loccountrycode: ((.loccountrycode // "") | text(2))
      }]
    ' <<<"$response")" || {
      json_error "Steam presence could not be reduced safely."
      return
    }

    summaries_json="$(printf '%s\n%s\n' "$summaries_json" "$next_players" \
      | jq -cs '.[0] + .[1]')" || {
      json_error "Steam presence could not be accumulated safely."
      return
    }
  done

  local normalized
  if ! normalized="$(printf '%s\n%s\n' "$friends_json" "$summaries_json" \
    | jq -cs --arg selfId "$steam_id" \
      '{selfId: $selfId, friends: .[0].friendslist, players: .[1]}' \
    | normalize_player)"; then
    json_error "Steam data could not be normalized."
    return
  fi

  if ! prepare_cache_dir \
    || ! write_private_file "$CACHE_DIR" "$CACHE_FILE" ".snapshot" "$normalized"; then
    normalized="$(jq -c '.warning = "Presence loaded, but the private cache could not be updated."' <<<"$normalized")"
  fi
  printf '%s\n' "$normalized"
}

setup_account() {
  local detected_id current_id steam_id api_key response friends_response input_id config_json privacy_file
  detected_id="$(detect_steam_id 2>/dev/null || true)"
  current_id=""
  privacy_file="${BASH_SOURCE[0]%/scripts/steam-friends}/PRIVACY.md"

  if read_config; then
    current_id="$(jq -r '.steamId // empty' "$CONFIG_FILE" 2>/dev/null || true)"
  fi

  clear
  printf '\033[1;36m%s\033[0m\n' '╭──────────────────────────────────────────────╮'
  printf '\033[1;36m│\033[0m    %-39s\033[1;36m│\033[0m\n' "$PLUGIN_NAME setup"
  printf '\033[1;36m%s\033[0m\n\n' '╰──────────────────────────────────────────────╯'
  printf 'This wizard stores your Steam Web API key locally in:\n  %s\n\n' "$CONFIG_FILE"
  printf 'The file is private to your user (mode 0600). The key is never\n'
  printf 'written to Omarchy shell.json or printed by the plugin.\n\n'
  printf 'Before continuing, review:\n  %s\n' "$privacy_file"
  printf 'Steam data is locally cached for up to 24 hours and provided as-is.\n'
  printf 'This independent community project is not affiliated with Valve or Steam.\n\n'

  if ! command -v curl >/dev/null 2>&1; then
    printf '\033[1;31mcurl is required but is not installed.\033[0m\n'
    read -r -p 'Press Enter to close…'
    return 1
  fi

  if [[ -n "$detected_id" ]]; then
    printf 'Detected Steam ID: \033[1m%s\033[0m\n' "$detected_id"
  fi

  steam_id="${current_id:-$detected_id}"
  read -r -p "Steam ID [${steam_id:-required}]: " input_id
  steam_id="${input_id:-$steam_id}"

  if [[ ! "$steam_id" =~ ^[0-9]{17}$ ]]; then
    printf '\n\033[1;31mInvalid Steam ID. It must contain exactly 17 digits.\033[0m\n'
    read -r -p 'Press Enter to close…'
    return 1
  fi

  printf '\nCreate a user API key at:\n'
  printf '\033[4;36mhttps://steamcommunity.com/dev/apikey\033[0m\n\n'
  read -r -s -p 'Steam Web API key (input hidden): ' api_key
  printf '\n'

  if [[ ! "$api_key" =~ ^[A-Fa-f0-9]{32}$ ]]; then
    printf '\n\033[1;31mInvalid API key. Steam user keys contain 32 hexadecimal characters.\033[0m\n'
    api_key=""
    read -r -p 'Press Enter to close…'
    return 1
  fi

  printf '\nValidating with Steam… '
  if ! response="$(api_get \
    "${API_ROOT}/GetPlayerSummaries/v2/" \
    "$api_key" \
    "steamids=${steam_id}" 2>/dev/null)" \
    || ! jq -e --arg id "$steam_id" \
      '.response.players | any(.steamid == $id)' <<<"$response" >/dev/null 2>&1; then
    printf '\033[1;31mfailed\033[0m\n\n'
    printf 'Steam rejected the key or Steam ID. Check both values and try again.\n'
    api_key=""
    read -r -p 'Press Enter to close…'
    return 1
  fi
  printf '\033[1;32mok\033[0m\n'

  printf 'Checking friends-list access… '
  if ! friends_response="$(api_get \
    "${API_ROOT}/GetFriendList/v1/" \
    "$api_key" \
    "steamid=${steam_id}" \
    'relationship=friend' 2>/dev/null)" \
    || ! jq -e '
      .friendslist.friends | type == "array"
      and length <= 5000
      and all(.[]; (
        type == "object"
        and (.steamid | type == "string" and test("^[0-9]{17}$"))
        and (.friend_since | type == "number" and . >= 0 and . <= 4102444800)
      ))
    ' <<<"$friends_response" >/dev/null 2>&1; then
    printf '\033[1;31mfailed\033[0m\n\n'
    printf 'Steam did not grant friends-list access. Make the list public and try again.\n'
    api_key=""
    read -r -p 'Press Enter to close…'
    return 1
  fi
  printf '\033[1;32mok\033[0m\n'

  printf -v config_json '{"apiKey":"%s","steamId":"%s"}' "$api_key" "$steam_id"
  if ! write_private_file "$CONFIG_DIR" "$CONFIG_FILE" ".steam-friends" "$config_json"; then
    printf '\n\033[1;31mThe private configuration could not be written safely.\033[0m\n'
    api_key=""
    config_json=""
    read -r -p 'Press Enter to close…'
    return 1
  fi
  api_key=""
  config_json=""

  printf '\n\033[1;32m✓ Steam Friends is connected.\033[0m\n'
  printf 'Your Omarchy panel will refresh automatically.\n\n'
  read -r -p 'Press Enter to close…'
}

